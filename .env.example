# Copy to .env for local development. Never commit real values.
APP_ENV=local
LOG_LEVEL=info

# Brand (dev bible §140) — the product name is configuration, not code.
BRAND_PRODUCT_NAME=170tarv
BRAND_EMAIL_SENDER_NAME=170tarv
BRAND_SUPPORT_EMAIL=support@example.invalid

WORKER_HEALTH_PORT=8081

# Database. The app connects as a non-superuser member of platform_app (RLS applies);
# migrations run as the owner. See docs/local-development.md.
DATABASE_URL=postgres://platform_app_login:change-me@127.0.0.1:5432/platform
DATABASE_MIGRATION_URL=postgres://platform:platform@127.0.0.1:5432/platform

# Public origin of the web app (Origin checks on state-changing requests).
APP_ORIGIN=http://localhost:3000

# AES-256-GCM key ring for secrets at rest: id:base64(32 bytes), first key encrypts.
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY

# Redis (BullMQ queues, rate limiting). appendonly + noeviction in production.
REDIS_URL=redis://127.0.0.1:6379

# Worker: incremental connector sync cadence.
CONNECTOR_SYNC_INTERVAL_MS=900000

# Evidence object storage: Cloudflare R2 in staging/production, SeaweedFS locally (D-001).
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=platform-dev
S3_ACCESS_KEY_ID=platform-dev
S3_SECRET_ACCESS_KEY=platform-dev-only
S3_FORCE_PATH_STYLE=true

# Worker only. Ed25519 manifest signing keys (secret): id:base64(pkcs8), first = active (§120).
# Generate with: pnpm --filter @platform/integrity generate-signing-key -- k1
MANIFEST_SIGNING_KEYS=k1:REPLACE_WITH_GENERATED_KEY
INTEGRITY_SEAL_INTERVAL_MS=300000
